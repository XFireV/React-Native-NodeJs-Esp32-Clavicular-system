import cv2
import os
import numpy as np
import face_recognition

# ==========================================
# CONFIGURAÇÕES
# ==========================================

DATASET_DIR = "faces"
USERS_FILE = "users.txt"
TOTAL_FOTOS = 10 # Com Deep Learning, 10 fotos são mais que suficientes!

ESP32_URL = "https://blog-disbelief-region.ngrok-free.dev"

os.makedirs(DATASET_DIR, exist_ok=True)

# Usamos o Haar Cascade apenas para detectar ONDE está o rosto na tela durante o cadastro
cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
)

# ==========================================
# UTILIDADES
# ==========================================

def carregar_usuarios():
    usuarios = {}
    if os.path.exists(USERS_FILE):
        with open(USERS_FILE, "r", encoding="utf-8") as f:
            for linha in f:
                if (linha.strip()):
                    uid, nome = linha.strip().split(";")
                    usuarios[int(uid)] = nome
    return usuarios


def salvar_usuario(uid, nome):
    with open(USERS_FILE, "a", encoding="utf-8") as f:
        f.write(f"{uid};{nome}\n")


# ==========================================
# CADASTRO
# ==========================================

def cadastrar():
    usuarios = carregar_usuarios()
    nome = input("Nome do usuário para cadastro: ")

    if usuarios:
        novo_id = max(usuarios.keys()) + 1
    else:
        novo_id = 1

    pasta = os.path.join(DATASET_DIR, str(novo_id))
    os.makedirs(pasta, exist_ok=True)

    cap = cv2.VideoCapture(0)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    contador = 0

    print(f"\n[INFO] Capturando {TOTAL_FOTOS} imagens para o cadastro...")
    print("[DICA] Mexa o rosto levemente para os lados durante a captura.")

    while contador < TOTAL_FOTOS:
        ret, frame = cap.read()
        if not ret:
            break

        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = cascade.detectMultiScale(gray, scaleFactor=1.2, minNeighbors=5)

        for (x, y, w, h) in faces:
            # No cadastro, salvamos a imagem colorida inteira ou recortada.
            # O face_recognition trabalha melhor com o frame original focado.
            contador += 1
            arquivo = os.path.join(pasta, f"{contador}.jpg")

            # Vamos salvar a foto da face com uma pequena margem
            rosto_colorido = frame[max(0, y-20):min(frame.shape[0], y+h+20),
                                   max(0, x-20):min(frame.shape[1], x+w+20)]

            if rosto_colorido.size > 0:
                cv2.imwrite(arquivo, rosto_colorido)

            cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)
            cv2.putText(frame, f"{contador}/{TOTAL_FOTOS}", (10, 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)

        cv2.imshow("Cadastro de Face", frame)
        cv2.waitKey(200) # Pausa menor para registrar rápido

    cap.release()
    cv2.destroyAllWindows()

    salvar_usuario(novo_id, nome)
    print("✅ Cadastro concluído com sucesso!")

#==============================================
#GERACAO DE ENCONDINGS
#===========================================

def gerar_encodings():

    print("\n[PROCESSANDO] Gerando banco de encodings...")

    encodings_por_usuario = {}

    for uid in os.listdir(DATASET_DIR):

        pasta = os.path.join(DATASET_DIR, uid)

        if not os.path.isdir(pasta):
            continue

        lista = []

        for arquivo in os.listdir(pasta):

            caminho = os.path.join(pasta, arquivo)

            try:

                imagem = face_recognition.load_image_file(caminho)

                encodings = face_recognition.face_encodings(imagem)

                if len(encodings) > 0:

                    lista.append(encodings[0])

                    print(
                        f"[OK] Usuário {uid} - {arquivo}"
                    )

                else:

                    print(
                        f"[AVISO] Nenhum rosto encontrado em {arquivo}"
                    )

            except Exception as e:

                print(
                    f"[ERRO] {arquivo}: {e}"
                )

        if len(lista) > 0:

            encodings_por_usuario[int(uid)] = lista

    if len(encodings_por_usuario) == 0:

        print("\n[ERRO] Nenhuma assinatura facial encontrada.")

        return False

    caminho_encodings = "encodings.pkl"

    try:

        import pickle

        with open(caminho_encodings, "wb") as arquivo:

            pickle.dump(
                encodings_por_usuario,
                arquivo
            )

        print(
            f"\n[OK] Banco de encodings salvo em {caminho_encodings}"
        )

        return True

    except Exception as e:

        print(
            f"\n[ERRO] Não foi possível salvar os encodings: {e}"
        )

        return False




# ==========================================
# RECONHECIMENTO (AQUI A MÁGICA ACONTECE)
# ==========================================


def reconhecer():

    usuarios = carregar_usuarios()

    if not usuarios:
        print("\n[ERRO] Nenhum usuário cadastrado.")
        return

    print("\n[PROCESSANDO] Carregando banco de encodings...")

    import pickle

    caminho_encodings = "encodings.pkl"

    if not os.path.exists(caminho_encodings):

        print("[ERRO] Banco de encodings não encontrado.")
        print("Execute a geração dos encodings primeiro.")

        return

    try:

        with open(caminho_encodings, "rb") as arquivo:

            encodings_por_usuario = pickle.load(arquivo)

    except Exception as e:

        print(
            f"[ERRO] Não foi possível carregar os encodings: {e}"
        )

        return

    if len(encodings_por_usuario) == 0:

        print("Nenhuma assinatura facial encontrada.")

        return

    print("[OK] Banco de encodings carregado.")

    # ======================================

    LIMIAR = 0.45
    NUM_MELHORES = 5

    cap = cv2.VideoCapture(0)

    cap.set(
        cv2.CAP_PROP_FRAME_WIDTH,
        640
    )

    cap.set(
        cv2.CAP_PROP_FRAME_HEIGHT,
        480
    )

    print("\n[INFO] Câmera pronta.")
    print("[ESPAÇO] Reconhecer")
    print("[ESC] Sair")

    while True:

        ret, frame = cap.read()

        if not ret:
            break

        h, w, _ = frame.shape

        cv2.rectangle(
            frame,
            (int(w/4), int(h/4)),
            (int(3*w/4), int(3*h/4)),
            (255,0,0),
            1
        )

        cv2.imshow(
            "Reconhecimento Facial",
            frame
        )

        tecla = cv2.waitKey(1) & 0xFF

        # ----------------------------------

        if tecla == 27:
            break

        # ----------------------------------

        if tecla == 32:

            rgb = cv2.cvtColor(
                frame,
                cv2.COLOR_BGR2RGB
            )

            locais = face_recognition.face_locations(
                rgb
            )

            encodings_camera = face_recognition.face_encodings(
                rgb,
                locais
            )

            if len(encodings_camera) == 0:

                print("Nenhum rosto encontrado.")

                continue

            acesso = False
            nome = "Desconhecido"

            melhor_media_global = 999
            melhor_uid = None
            melhor_local = None

            # ==========================================
            # Analisa cada rosto encontrado na câmera
            # ==========================================

            for encoding_camera, local in zip(
                encodings_camera,
                locais
            ):

                for uid, lista_encodings in encodings_por_usuario.items():

                    distancias = face_recognition.face_distance(
                        lista_encodings,
                        encoding_camera
                    )

                    # Ordena da menor para maior

                    distancias = np.sort(
                        distancias
                    )

                    quantidade = min(
                        NUM_MELHORES,
                        len(distancias)
                    )

                    media = np.mean(
                        distancias[:quantidade]
                    )

                    print(
                        f"{usuarios[uid]} -> média = {media:.4f}"
                    )

                    if media < melhor_media_global:

                        melhor_media_global = media
                        melhor_uid = uid
                        melhor_local = local

            print(
                f"\nMelhor média encontrada: "
                f"{melhor_media_global:.4f}"
            )

            if melhor_media_global < LIMIAR:

                acesso = True

                nome = usuarios[melhor_uid]

                top, right, bottom, left = melhor_local

                cv2.rectangle(
                    frame,
                    (left, top),
                    (right, bottom),
                    (0,255,0),
                    3
                )

                cv2.putText(
                    frame,
                    f"{nome}",
                    (left, top-10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.8,
                    (0,255,0),
                    2
                )

            else:

                cv2.putText(
                    frame,
                    "DESCONHECIDO",
                    (30,40),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    1,
                    (0,0,255),
                    2
                )

            cv2.imshow(
                "Reconhecimento Facial",
                frame
            )

            cv2.waitKey(1500)

            if acesso:
                print(f"\n✅ ACESSO LIBERADO -> {nome}")
                print(f"Distância média: {melhor_media_global:.4f}")

                # ENVIO HTTPS PARA O ESP32
                payload = {
                    "nome": nome,
                    "confirm": True
                }
                
