    print("5 - Gerar Encondings")
    print("0 - Sair")

    op = input("Opção: ")

    if op == "1":
        cadastrar()
    elif op == "2":
        reconhecer()
    elif op == "3":
        listar()
    elif op == "4":
        excluir()
    elif op == "5":
        gerar_encodings()
    elif op == "0":
        break
