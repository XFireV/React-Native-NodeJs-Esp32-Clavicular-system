                    if resposta.status_code == 200:
                        print("🌐 [OK] ESP32 ativado com sucesso!")
                    else:
                        print(f"⚠️ [ERRO] ESP32 retornou status: {resposta.status_code}")
                
                except requests.exceptions.RequestException as e:
                    print(f"❌ [FALHA] Não foi possível comunicar com o ESP32: {e}")
                # ==========================================

            else:
                print("\n❌ ACESSO NEGADO")

            break

    cap.release()

    cv2.destroyAllWindows()


# ==========================================
# LISTAR
# ==========================================

def listar():
    usuarios = carregar_usuarios()
    print("\n=== USUÁRIOS CADASTRADOS ===")
    for uid, nome in usuarios.items():
        print(f"ID: {uid} - Nome: {nome}")


# ==========================================
# EXCLUIR
# ==========================================

def excluir():
    usuarios = carregar_usuarios()
    listar()

    try:
        uid = int(input("\nDigite o ID para excluir: "))
    except ValueError:
        print("ID inválido.")
        return

    if uid not in usuarios:
        print("Usuário não encontrado.")
        return

    pasta = os.path.join(DATASET_DIR, str(uid))
    if os.path.exists(pasta):
        for arq in os.listdir(pasta):
            os.remove(os.path.join(pasta, arq))
        os.rmdir(pasta)

    del usuarios[uid]

    with open(USERS_FILE, "w", encoding="utf-8") as f:
        for k, v in usuarios.items():
            f.write(f"{k};{v}\n")

    print("Usuário removido com sucesso.")


# ==========================================
# MENU PRINCIPAL
# ==========================================

while True:
    print("\n==============================")
    print(" CLAVICULÁRIO ELETRÔNICO v2.0 ")
    print("==============================")
    print("1 - Cadastrar Novo Usuário")
